<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg">

    <!--  Carátula o ícono -->
    <ImageView
        android:id="@+id/imgWidgetArt"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/sound_icon"
        android:contentDescription="Carátula"
        android:scaleType="centerCrop"
        android:background="@drawable/album_art_bg"
        android:layout_marginEnd="10dp" />

    <!--  Texto: título + estado -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tvWidgetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Título actual"
            android:textColor="@color/jordan_black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detenido"
            android:textColor="@color/jordan_black"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ️ Botón Play/Pause -->
    <ImageButton
        android:id="@+id/btnUpdate"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_play_arrow"
        android:background="?android:selectableItemBackgroundBorderless"
        android:contentDescription="Reproducir/Pausar"
        app:tint="@android:color/white"
        android:padding="6dp"
        android:layout_marginEnd="6dp" />

    <!--  Botón Stop -->
    <ImageButton
        android:id="@+id/btnStop"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_stop"
        android:background="?android:selectableItemBackgroundBorderless"
        android:contentDescription="Detener"
        app:tint="@android:color/white"
        android:padding="6dp" />
</LinearLayout>
