<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jordan_white"
    tools:context=".SoundPlayerActivity">

    <!-- Tarjeta del reproductor -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPlayer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="30dp"
        app:strokeColor="@color/jordan_red"
        app:strokeWidth="4dp"
        app:cardElevation="8dp"
        android:layout_margin="16dp"
        android:backgroundTint="@color/jordan_white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Imagen o carátula -->

            <!-- Título -->

            <ImageView
                android:id="@+id/imgCoverArt"
                android:layout_width="match_parent"
                android:layout_height="368dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="30dp"
                android:adjustViewBounds="true"
                android:background="@drawable/player_frame_red"
                android:clipToOutline="true"
                android:contentDescription="@string/album_art"
                android:scaleType="centerCrop"
                android:src="@drawable/sound_icon" />

            <TextView
                android:id="@+id/SoundTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título de la canción"
                android:textSize="22sp"
                android:textColor="@color/jordan_black"                android:textStyle="bold"
                android:gravity="center"/>

            <!-- Estado -->
            <TextView
                android:id="@+id/tvState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reproduciendo"
                android:textColor="@color/jordan_black"
                android:textSize="17sp"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <!-- Línea de progreso simulada -->
            <ImageView
                android:id="@+id/waveProgress"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/wave_shape_am"
                android:scaleType="fitCenter"
                android:contentDescription="@string/audio_wave"
                android:alpha="0.9"/>

            <!-- Controles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPause"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="16dp"
                    android:backgroundTint="@color/jordan_shadow"                    android:contentDescription="@string/pause"
                    app:icon="@drawable/ic_pause"
                    app:iconSize="33dp"
                    app:iconTint="@color/jordan_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlay"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="16dp"
                    android:backgroundTint="@color/jordan_red"                    android:contentDescription="@string/play"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconSize="44dp"
                    app:iconTint="@color/jordan_white"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStop"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/jordan_shadow"                    android:contentDescription="@string/stop"
                    app:icon="@drawable/ic_stop"
                    app:iconSize="33dp"
                    app:iconTint="@color/jordan_white" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
